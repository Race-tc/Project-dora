# ── Anthropic (your key — never shared with users) ────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Voice — Dora's speech-to-text / text-to-speech (your keys — never shared
# with users; voice is billed through the customer's licence key, same as
# text AI). Leave blank to disable voice for all users. ───────────────────────
OPENAI_API_KEY=sk-...
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
ELEVENLABS_API_KEY=sk_...
# Default voice — override per-request from the client, or change the default here
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Get this after setting up a webhook endpoint in Stripe dashboard
# Webhook URL: https://your-domain.com/webhook
# Events to listen for: checkout.session.completed,
#   customer.subscription.updated, customer.subscription.deleted,
#   invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...
# Create TWO prices on the same product at https://dashboard.stripe.com/products
# One one-time price (£150 setup fee) and one recurring price (£20/month).
# Both are charged together in a single Checkout session.
STRIPE_SETUP_PRICE_ID=price_...
STRIPE_PRICE_ID=price_...

# ── Admin ─────────────────────────────────────────────────────────────────────
# A secret you choose — used to access /admin endpoints
ADMIN_TOKEN=change-me-to-something-secret

# ── Server ────────────────────────────────────────────────────────────────────
BASE_URL=https://api.projectdora.com
SITE_URL=https://projectdora.com

# ── Email (Resend — HTTP API, not SMTP; raw SMTP ports are blocked on most
# PaaS free/hobby tiers) ────────────────────────────────────────────────────
# Get a key at https://resend.com/api-keys (free tier: 3,000 emails/month)
RESEND_API_KEY=re_...
# Default sender needs no setup. To send from your own domain instead,
# verify it at https://resend.com/domains, then set e.g.
# EMAIL_FROM=DORA <licences@yourdomain.com>
EMAIL_FROM=DORA <onboarding@resend.dev>

# ── Database ──────────────────────────────────────────────────────────────────
# On Railway: set to /data/dora.db and mount a volume at /data
# Locally: leave blank (defaults to backend/dora.db)
DB_PATH=/data/dora.db
