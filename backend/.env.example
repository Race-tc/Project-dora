# ── Anthropic (your key — never shared with users) ────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Get this after setting up a webhook endpoint in Stripe dashboard
# Webhook URL: https://your-domain.com/webhook
# Events to listen for: checkout.session.completed,
#   customer.subscription.updated, customer.subscription.deleted,
#   invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...
# Create a recurring price at https://dashboard.stripe.com/products
# Set it to £30/month, copy the price ID (price_xxx)
STRIPE_PRICE_ID=price_...

# ── Admin ─────────────────────────────────────────────────────────────────────
# A secret you choose — used to access /admin endpoints
ADMIN_TOKEN=change-me-to-something-secret

# ── Server ────────────────────────────────────────────────────────────────────
BASE_URL=https://api.projectdora.com
SITE_URL=https://projectdora.com

# ── Email (Gmail example — use an App Password, not your real password) ───────
# Guide: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your@gmail.com

# ── Database ──────────────────────────────────────────────────────────────────
# On Railway: set to /data/dora.db and mount a volume at /data
# Locally: leave blank (defaults to backend/dora.db)
DB_PATH=/data/dora.db
